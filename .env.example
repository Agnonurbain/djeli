# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google AI (Gemini)
GOOGLE_AI_API_KEY=

# Twilio — Auth OTP SMS (utilisé par Supabase Auth via config.toml)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
