# Twilio — WhatsApp (rapports parents)
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=

# CinetPay (Mobile Money)
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CINETPAY_SECRET_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
